flowchart TD
    USER["User / operator"] --> UI["React + JavaScript dashboard"]
    UI -->|"HTTP: /api/chat"| API["FastAPI"]
    UI <-->|"WebSocket: /ws"| EVENTS["In-memory event hub"]

    subgraph BACKEND["Backend"]
        API --> AGENT["Pydantic AI agent"]
        AGENT -->|"guarded tool adapter"| GATE["ShadowGuard interceptor"]
        GATE --> TRUST["Trust registry + model signals"]
        GATE --> INTENT["Capability, intent, and SQL policy"]
        GATE --> TAINT["Session taint + provenance"]
        TRUST --> POLICY{"Policy decision"}
        INTENT --> POLICY
        TAINT --> POLICY
        POLICY -->|"deny"| BLOCK["Block and audit"]
        POLICY -->|"permitted"| ADAPTER["Integration adapter"]
        POLICY -->|"protected SQL action"| SHADOW["In-memory SQLite simulation"]
        SHADOW -->|"pending action"| APPROVAL["Approval manager"]
        APPROVAL -->|"pending status"| AGENT
        UI -->|"POST decision + Bearer operator token"| APPROVAL
        APPROVAL -->|"revalidate then execute"| DB["Local production-demo SQLite"]
        GATE --> AUDIT["SQLite audit/session database"]
        APPROVAL --> AUDIT
        BLOCK --> EVENTS
        APPROVAL --> EVENTS
        AUDIT --> EVENTS
    end

    subgraph INTEGRATIONS["Registered integrations"]
        GH["GitHub Contents API"]
        WEATHER["Open-Meteo"]
    end
    ADAPTER --> GH
    ADAPTER --> WEATHER

    NOTE["FastMCP tool decorators are present, but this app does not start a standalone MCP transport. The chat path uses guarded Pydantic AI tools."]
    NOTE -.-> AGENT
